<resources>
    <style name="Theme.TrimeAppTheme.Api" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.TrimeAppTheme" parent="Theme.TrimeAppTheme.Api">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="colorControlNormal">@color/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
    </style>

    <!-- ClipEditActivity 的透明宿主：真正的编辑窗是该 Activity 内弹出的 MD3 对话框
    （materialAlertDialogBuilder，与剪贴板过滤规则弹框同一窗口参数：宽度/圆角/居中），
    宿主自身不能渲染任何可见窗口，否则对话框底下还叠着一层全屏底板。配色保留给
    对话框 builder 解析用（强调色、按钮色从 context 主题取）。 -->
    <style name="Theme.DialogTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- 剪贴板编辑窗：弹出即聚焦输入框，键盘随窗口焦点自动升起（adjustResize
             保证键盘升起时对话框内容可见）。 -->
        <item name="android:windowSoftInputMode">adjustResize|stateAlwaysVisible</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
    </style>

    <style name="ShapeAppearanceOverlay.Trime.SettingsCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!--
    IME 路径弹框的单选圆点由 RadioListAdapter 自绘条目实现（主题层替换布局会被
    MaterialAlertDialogBuilder 后套的主题遮蔽，drawableLeftCompat 依赖的 LayoutInflater
    factory 又只有 Activity 有），此处不再需要任何弹框 overlay。
    -->
</resources>
